+    async def _send_placeholder(self) -> None:
+        """Send the optional 'running…' placeholder before the first token.
+
+        Only fires when ``cfg.placeholder_text`` is set and the run is not
+        using native draft streaming (a draft frame is itself the live
+        preview, so a separate placeholder would double up). Best-effort:
+        any failure is swallowed so a flaky placeholder never blocks the
+        real answer — on failure ``_message_id`` stays None and the first
+        real delta takes the normal first-send path. On success the
+        placeholder becomes the editable message the first delta edits.
+        """
+        if not self.cfg.placeholder_text or self._use_draft_streaming:
+            return
+        try:
+            result = await self.adapter.send(
+                chat_id=self.chat_id,
+                content=self.cfg.placeholder_text,
+                reply_to=self._initial_reply_to_id,
+                metadata=self._metadata_for_send(expect_edits=True),
+            )
+        except Exception as e:
+            logger.debug("Stream placeholder send failed: %s", e)
+            return
+        if getattr(result, "success", False) and getattr(result, "message_id", None):
+            self._message_id = str(result.message_id)
+            self._track_preview_ids_from_result(result)
+            self._already_sent = True
+            self._last_sent_text = self.cfg.placeholder_text
+            self._notify_new_message()
+
     def _visible_prefix(self) -> str:
         """Return the visible text already shown in the streamed message."""
         prefix = self._last_sent_text or ""
diff --git a/tests/gateway/test_stream_consumer_placeholder.py b/tests/gateway/test_stream_consumer_placeholder.py
new file mode 100644
index 0000000..6eca470
--- /dev/null
+++ b/tests/gateway/test_stream_consumer_placeholder.py
@@ -0,0 +1,106 @@
+"""Tests for the optional 'running…' placeholder message.
+
+When ``StreamConsumerConfig.placeholder_text`` is set, the consumer sends a
+short placeholder message *before* the first streamed token so the user sees
+immediate feedback on slow-first-token models. The first real delta then
+edits that placeholder in place (it must not create a second message).
+"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.stream_consumer import GatewayStreamConsumer, StreamConsumerConfig
+from gateway.config import StreamingConfig
+
+
+def _make_adapter(first_msg_id: str = "ph1") -> MagicMock:
+    adapter = MagicMock()
+    adapter.send = AsyncMock(
+        return_value=SimpleNamespace(success=True, message_id=first_msg_id)
+    )
+    adapter.edit_message = AsyncMock(
+        return_value=SimpleNamespace(success=True, message_id=first_msg_id)
+    )
+    adapter.MAX_MESSAGE_LENGTH = 4096
+    return adapter
+
+
+class TestPlaceholderMessage:
+    @pytest.mark.asyncio
+    async def test_placeholder_sent_before_first_token(self):
+        """placeholder_text set -> a placeholder is sent first and the first
+        real delta edits it (exactly one send, at least one edit)."""
+        adapter = _make_adapter(first_msg_id="ph1")
+        cfg = StreamConsumerConfig(placeholder_text="🤔 running…")
+        consumer = GatewayStreamConsumer(adapter, "chat_1", config=cfg)
+
+        consumer.on_delta("Hello world")
+        consumer.finish()
+        await consumer.run()
+
+        # The one and only send is the placeholder.
+        adapter.send.assert_awaited_once()
+        assert adapter.send.await_args.kwargs["content"] == "🤔 running…"
+
+        # Real text was delivered by editing the placeholder, not a new send.
+        assert adapter.edit_message.await_count >= 1
+        assert consumer.message_id == "ph1"
+
+    @pytest.mark.asyncio
+    async def test_no_placeholder_by_default(self):
+        """No placeholder_text -> behaviour unchanged: first send is real
+        content, no leading 'running…' bubble."""
+        adapter = _make_adapter(first_msg_id="m1")
+        consumer = GatewayStreamConsumer(adapter, "chat_1", config=StreamConsumerConfig())
+
+        consumer.on_delta("Hello world")
+        consumer.finish()
+        await consumer.run()
+
+        assert adapter.send.await_count >= 1
+        first = adapter.send.await_args_list[0]
+        assert "Hello world" in first.kwargs["content"]
+        for call in adapter.send.await_args_list:
+            assert "running" not in (call.kwargs.get("content") or "")
+
+    @pytest.mark.asyncio
+    async def test_placeholder_send_failure_does_not_break_stream(self):
+        """If the placeholder send fails, the consumer still delivers the
+        real answer through the normal first-send path."""
+        adapter = _make_adapter(first_msg_id="m1")
+        # First send (placeholder attempt) raises; subsequent behaviour must
+        # recover so the real text still reaches the user.
+        adapter.send = AsyncMock(
+            side_effect=[RuntimeError("boom"), SimpleNamespace(success=True, message_id="m1")]
+        )
+        cfg = StreamConsumerConfig(placeholder_text="🤔 running…")
+        consumer = GatewayStreamConsumer(adapter, "chat_1", config=cfg)
+
+        consumer.on_delta("Hello world")
+        consumer.finish()
+        await consumer.run()
+
+        # Two send attempts (failed placeholder + real first-send).
+        assert adapter.send.await_count == 2
+        assert adapter.send.await_args_list[1].kwargs["content"] == "Hello world"
+
+
+class TestPlaceholderConfigRoundTrip:
+    """placeholder_text survives StreamingConfig to_dict/from_dict, and the
+    gateway wires it through to the consumer config."""
+
+    def test_streaming_config_round_trip(self):
+        cfg = StreamingConfig(placeholder_text="🤔 running…")
+        restored = StreamingConfig.from_dict(cfg.to_dict())
+        assert restored.placeholder_text == "🤔 running…"
+
+    def test_streaming_config_default_none(self):
+        assert StreamingConfig().placeholder_text is None
+        assert StreamingConfig.from_dict({}).placeholder_text is None
+
+    def test_streaming_config_rejects_non_str(self):
+        # A stray non-string value must not crash the loader.
+        restored = StreamingConfig.from_dict({"placeholder_text": 123})
+        assert restored.placeholder_text is None
-- 
