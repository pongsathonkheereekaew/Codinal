#!/bin/bash
# project-ctx easby|auric — print workdir + sub-project git state for Telegram slash quick-commands.
case "$1" in
  easby) root="$HOME/Downloads/Easby Plugins" ;;
  auric) root="$HOME/Downloads/AURIC" ;;
  *) echo "usage: project-ctx easby|auric"; exit 0 ;;
esac
[ -d "$root" ] || { echo "NOT FOUND: $root"; exit 0; }
echo "📁 $root"
cd "$root" || exit 0
# root repo state
if [ -d .git ]; then
  printf "root: %s  %s\n" "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" \
    "$([ -n "$(git status --porcelain 2>/dev/null)" ] && echo '⚠ dirty' || echo '✓ clean')"
fi
echo "--- sub-projects ---"
found=0
for d in */; do
  [ -d "$d/.git" ] || continue
  found=1
  name="${d%/}"
  br=$(cd "$d" && git rev-parse --abbrev-ref HEAD 2>/dev/null)
  st=$(cd "$d" && git status --porcelain 2>/dev/null | grep -q . && echo '⚠' || echo '✓')
  printf "  %-8s %-20s %s\n" "$name" "${br:-(no branch)}" "$st"
done
[ "$found" = 0 ] && echo "(no nested git repos — single project)"
echo "--- recent (root) ---"
git log --oneline -5 2>/dev/null
