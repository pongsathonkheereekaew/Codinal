#!/usr/bin/env bash
# Universal ~/.agents harness entrypoint.
# Usage: harness <sync|rules|doctor|update|help>
set -euo pipefail

# Resolve symlinks (e.g. ~/.local/bin/harness → ~/.agents/scripts/harness)
_harness_src="${BASH_SOURCE[0]}"
while [[ -L "$_harness_src" ]]; do
  _harness_dir="$(cd -P "$(dirname "$_harness_src")" && pwd)"
  _harness_src="$(readlink "$_harness_src")"
  [[ "$_harness_src" != /* ]] && _harness_src="$_harness_dir/$_harness_src"
done
ROOT="$(cd -P "$(dirname "$_harness_src")/.." && pwd)"
SCRIPTS="$ROOT/scripts"
unset _harness_src _harness_dir

cmd="${1:-help}"
# Commands implemented in Python (host / verify) take their own subargs.
uninstall_cmd() {
  local host="${1:-}"
  if [[ -z "$host" ]]; then
    echo "usage: harness uninstall <host>   (ownership-aware; removes only harness-owned paths)" >&2
    exit 2
  fi
  exec python3 "$SCRIPTS/harness_host.py" --agents-home "$ROOT" host uninstall "$host"
}

case "$cmd" in
  host|verify)
    exec python3 "$SCRIPTS/harness_host.py" "$@"
    ;;
  agent)
    exec python3 "$SCRIPTS/harness_agent.py" "${@:2}"
    ;;
  skill)
    exec python3 "$SCRIPTS/harness_skill.py" "${@:2}"
    ;;
  install)
    local_repo="${HARNESS_FLOW_HOME:-$HOME/harness-flow}"
    if [[ ! -x "$local_repo/install.sh" ]]; then
      echo "ERROR: no install.sh at $local_repo (set HARNESS_FLOW_HOME or clone ~/harness-flow)" >&2
      exit 1
    fi
    exec "$local_repo/install.sh"
    ;;
  uninstall)
    shift
    uninstall_cmd "$@"
    ;;
esac

sync_cmd() {
  exec "$SCRIPTS/sync-skill-links.sh"
}

rules_cmd() {
  exec "$SCRIPTS/gen-cursor-rules.sh"
}

update_cmd() {
  local repo="${HARNESS_FLOW_HOME:-$HOME/harness-flow}"
  if [[ ! -d "$repo/.git" ]]; then
    echo "ERROR: no clone at $repo — run bootstrap once:" >&2
    echo "  git clone git@github.com:pongsathonkheereekaew/harness-flow.git ~/harness-flow && ~/harness-flow/bootstrap.sh" >&2
    exit 1
  fi
  echo "=== harness update ($repo) ==="
  git -C "$repo" pull --ff-only
  "$repo/install.sh"
}

doctor_cmd() {
  python3 - "$ROOT" <<'PY'
import os, sys
from pathlib import Path

root = Path(sys.argv[1])
home = Path.home()
skills = root / "skills"
policy = root / "AGENTS.md"

adapters = [
    home / ".claude" / "skills",
    home / ".cursor" / "skills",
    home / ".openclaw" / "skills",
    home / ".gemini" / "skills",
    home / ".zcode" / "skills",
]

policy_links = [
    home / ".codex" / "AGENTS.md",
    home / ".zcode" / "AGENTS.md",
    home / ".config" / "opencode" / "AGENTS.md",
    home / ".gemini" / "GEMINI.md",
]

print("=== harness doctor ===")
print(f"SSOT: {root}")
print(f"skills: {sum(1 for p in skills.iterdir() if not p.name.startswith('.'))}")
print(f"AGENTS.md: {'OK' if policy.is_file() else 'MISSING'}")
mem = root / "memory"
mem_ok = mem.is_dir() and (mem / "MEMORY.md").is_file()
print(f"memory/: {'OK' if mem_ok else 'MISSING'} ({sum(1 for p in mem.iterdir() if not p.name.startswith('.')) if mem.is_dir() else 0} files)")

claude_md = home / ".claude" / "CLAUDE.md"
print(f"CLAUDE.md: {'OK' if claude_md.is_file() else 'MISSING'}")
if claude_md.is_file():
    text = claude_md.read_text(encoding="utf-8", errors="replace")
    if "AGENTS.md" in text or ".agents/AGENTS" in text:
        print("CLAUDE.md → AGENTS.md: OK")
    else:
        print("CLAUDE.md → AGENTS.md: WARN")

claude_mem = home / ".claude" / "projects" / "-" / "memory"
if claude_mem.is_symlink():
    target = Path(os.readlink(claude_mem))
    if not target.is_absolute():
        target = (claude_mem.parent / target).resolve()
    want = (root / "memory").resolve()
    print(f"Claude memory → durable: {'OK' if target.resolve() == want else 'WARN ' + str(target)}")
elif claude_mem.is_dir():
    print("Claude memory → durable: WARN (real dir; prefer symlink to ~/.agents/memory)")
elif (home / ".claude").is_dir():
    print("Claude memory → durable: MISSING")
else:
    print("Claude memory → durable: (no ~/.claude)")

print("\n=== policy links ===")
for dest in policy_links:
    if dest.is_symlink():
        print(f"OK  {dest} -> {os.readlink(dest)}")
    elif dest.is_file():
        print(f"WARN real file (prefer symlink): {dest}")
    else:
        print(f"MISSING {dest}")

# Cursor: no global AGENTS.md — alwaysApply agents-policy.mdc is the bridge
cursor_policy = home / ".cursor" / "rules" / "agents-policy.mdc"
if cursor_policy.is_file():
    ctext = cursor_policy.read_text(encoding="utf-8", errors="replace")
    ok = (
        "alwaysApply: true" in ctext
        and "AGENTS.md — universal agent policy" in ctext
    )
    print(f"Cursor agents-policy.mdc: {'OK' if ok else 'WARN (stale — run: harness rules)'}")
else:
    print("Cursor agents-policy.mdc: MISSING (run: harness rules) — Cursor has no global AGENTS.md")

print("\n=== native ~/.agents/skills readers (no adapter required) ===")
print("  Codex, Gemini CLI, OpenCode — discover ~/.agents/skills directly")

print("\n=== adapter skill dirs ===")
for d in adapters:
    if not d.is_dir():
        print(f"{d}: MISSING")
        continue
    real, broken, links = [], [], 0
    for p in sorted(d.iterdir()):
        if p.name.startswith("."):
            continue
        if p.is_symlink():
            links += 1
            if not p.exists():
                broken.append(p.name)
        elif p.is_dir() or p.is_file():
            real.append(p.name)
    status = "OK" if not real and not broken else "WARN"
    print(f"{d}: {status}  links={links}  real={len(real)}  broken={len(broken)}")
    if real:
        print(f"  real copies: {', '.join(real[:15])}")
    if broken:
        print(f"  broken: {', '.join(broken[:15])}")

# Optional: assert skills you care about exist (customize names)
for name in ("verification-before-completion", "ask-matt"):
    src = skills / name
    if src.exists():
        print(f"optional {name}: OK")

print("\n=== Level-1 skill budget ===")
import re

def _parse_skill_frontmatter(skill_md: Path):
    try:
        text = skill_md.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    if not text.startswith("---"):
        return None
    end = text.find("\n---", 3)
    if end == -1:
        return None
    fm = text[3:end]
    disable = bool(re.search(r"(?m)^disable-model-invocation:\s*true\s*$", fm))
    m = re.search(r"(?m)^description:\s*(.*)$", fm)
    if not m:
        desc = ""
    else:
        first = m.group(1).strip()
        if first in (">", "|", ">-", "|-", "") or first.startswith(">"):
            lines = []
            for line in fm[m.end():].splitlines():
                stripped = line.strip()
                if re.match(r"^[A-Za-z0-9_-]+:", stripped) and not line.startswith((" ", "\t")):
                    break
                if line.startswith((" ", "\t")) or stripped == "":
                    if stripped:
                        lines.append(stripped)
                else:
                    break
            desc = " ".join(lines)
        else:
            desc = first.strip('"').strip("'")
    # rough est — not measured; ~1.3 tokens/word + small name overhead
    words = len(desc.split()) if desc else 0
    est = max(1, int(words * 1.3 + 5))
    return disable, len(desc), est, desc

GCP_PREFIXES = (
    "gke-", "google-", "bigquery", "alloydb", "cloud-", "firebase", "gcloud",
    "agent-platform", "workload", "iam-", "datalineage", "detection-", "gemini-",
)
rows = []
if skills.is_dir():
    for entry in sorted(skills.iterdir()):
        if entry.name.startswith("."):
            continue
        skill_md = entry / "SKILL.md"
        if not skill_md.is_file():
            continue
        parsed = _parse_skill_frontmatter(skill_md)
        if not parsed:
            continue
        disable, chars, est, _desc = parsed
        rows.append((entry.name, disable, chars, est))

invoked = [r for r in rows if not r[1]]
user_inv = [r for r in rows if r[1]]
inv_tok = sum(r[3] for r in invoked)
gcp = [r for r in invoked if r[0].startswith(GCP_PREFIXES) or r[0] in ("bigquery-ai-ml", "bigquery-basics", "bigquery-bigframes", "bigtable-basics", "firebase-basics", "gcloud", "workload-manager-basics")]
gcp_tok = sum(r[3] for r in gcp)
print(f"scanned SKILL.md: {len(rows)}")
print(f"model-invoked: {len(invoked)}  user-invoked: {len(user_inv)}")
print(f"est tokens (model-invoked): ~{inv_tok}")
if inv_tok > 0 and gcp:
    pct = int(round(100 * gcp_tok / inv_tok))
    print(f"GCP/Google-ish share: ~{gcp_tok} (~{pct}%)")
elif not gcp:
    print("GCP/Google-ish share: (none detected)")
top = sorted(invoked, key=lambda x: -x[2])[:5]
if top:
    print("Top 5 longest model-invoked descriptions:")
    for name, _dis, chars, est in top:
        print(f"  {chars:4d}c ~{est:3d}t  {name}")
print("Hint: prefer thinner descriptions; rare packs can use disable-model-invocation")
print("(est = word count x 1.3 + 5 — not measured; non-fatal)")

print("\n=== install-and-go probes ===")
import shutil
harness_bin = home / ".local" / "bin" / "harness"
if harness_bin.is_symlink() or harness_bin.is_file():
    print(f"PATH harness: OK {harness_bin}")
else:
    print("PATH harness: MISSING (~/.local/bin/harness) — re-run ./install.sh")
which_harness = shutil.which("harness")
if which_harness:
    print(f"harness on PATH: OK {which_harness}")
else:
    print('harness on PATH: WARN (open a new shell, or export PATH="$HOME/.local/bin:$PATH")')
skill_creator = skills / "skill-creator"
print(f"skill-creator: {'OK' if skill_creator.exists() else 'MISSING'}")
settings = home / ".claude" / "settings.json"
if settings.is_file():
    try:
        import json
        data = json.loads(settings.read_text(encoding="utf-8"))
        plugins = data.get("enabledPlugins") or {}
        for need in ("claude-mem@thedotmack", "superpowers@claude-plugins-official"):
            print(f"Claude plugin {need}: {'OK' if plugins.get(need) else 'WARN (open Claude Code once to install)'}")
    except Exception as e:
        print(f"Claude settings: WARN ({e})")
else:
    print("Claude settings: MISSING — re-run ./install.sh")

print("\n=== machine probes (non-fatal) ===")
for bin_name in ("rtk", "lowfat"):
    path = shutil.which(bin_name)
    print(f"{bin_name}: {'OK ' + path if path else 'MISSING (optional)'}")

hermes_cfg = home / ".hermes" / "config.yaml"
if hermes_cfg.is_file():
    htext = hermes_cfg.read_text(encoding="utf-8", errors="replace")
    if "external_dirs" in htext and ".agents/skills" in htext:
        print("hermes external_dirs → ~/.agents/skills: OK")
    else:
        print("hermes external_dirs → ~/.agents/skills: WARN (add skills.external_dirs)")
else:
    print("hermes config: (absent — ok if office stack not installed)")

print("\nDone. Fix drift then: harness sync")
PY
}

help_cmd() {
  cat <<EOF
harness — ~/.agents universal content harness

Usage:
  harness sync                          Symlink skills + wire AGENTS.md for all adapters
  harness rules                         Regenerate ~/.cursor/rules/*.mdc from standards/
  harness doctor                        Drift / health check
  harness host list                     List hosts + tier + capability coverage
  harness host inspect [name|--all]     Show capabilities + smoke probes
  harness host provision <name>         Render host adapter into \$HOME
                                         (--dry-run, --enable SKILL)
  harness host uninstall <name>         Remove harness-owned paths for a host
  harness verify [--host N] [--tier N]  Effective-state verification
                  [--project DIR] [--json]
  harness skill list [--all] [--json]   List skills with class + state
  harness skill enable NAME             Enable a catalog skill
  harness skill disable NAME            Disable a catalog skill (core refused)
  harness skill reset                   Re-enable every disabled skill
  harness skill audit [--json]          Classification + journal health
  harness update                        git pull ~/harness-flow && ./install.sh
  harness help                          This text

New machine (once):
  git clone <repo> ~/harness-flow && ~/harness-flow/bootstrap.sh

Install a skill (once):
  cp -R <skill-dir> ~/.agents/skills/<name>
  harness sync

Coverage after sync:
  Skills adapters: Claude, Cursor, Openclaw, Gemini (~/.gemini/skills), ZCode (~/.zcode/skills)
  Native skills:   Codex + Gemini + OpenCode also read ~/.agents/skills
  Policy:          ~/.codex/AGENTS.md, ~/.zcode/AGENTS.md,
                   ~/.config/opencode/AGENTS.md, ~/.gemini/GEMINI.md
                   (+ Claude via ~/.claude/CLAUDE.md @AGENTS.md)
EOF
}

case "$cmd" in
  sync) sync_cmd ;;
  rules) rules_cmd ;;
  doctor) doctor_cmd ;;
  update) update_cmd ;;
  help|-h|--help) help_cmd ;;
  *)
    echo "unknown command: $cmd" >&2
    help_cmd >&2
    exit 1
    ;;
esac
