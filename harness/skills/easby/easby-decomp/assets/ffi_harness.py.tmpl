#!/usr/bin/env python3
"""AC-1 direct-FFI harness. dlopen the plugin binary, drive the Rust `dynamics` core
straight through its C ABI — no DAW, no host, sample-exact, and the GETTERS expose
internal state (gain reduction, link lambda, rms weights) that pedalboard can't see.

Signatures recovered from radare2 (AC-1/decomp), AArch64 ABI:
  create() -> *mut Handle                      (heap struct, 0x3148 bytes)
  destroy/reset(handle)
  set_<continuous>(handle, f64)                value in d0   (threshold_db, ratio, knee_db, link_*, times…)
  set_<int/bool>(handle, i32)                  value in w1   (compression_mode, linking_enabled, link_n…)
  get_<continuous>(handle) -> f64
  get_<int>(handle) -> i32
  process_audio_mono_f64(handle, *f64 buf, len, len2)   in-place; inner uses min(len,len2)

VERIFY before trusting: the process 4th arg (len2) and exact dtype of non-_f64 paths.
Run:  python Tools/ac1_ffi.py            # self-test: create, set, process a sine, read GR/lambda
"""
import ctypes as C
import os, sys, numpy as np

BIN = os.environ.get("AC1_BIN", "/Library/Audio/Plug-Ins/VST3/AC-1.vst3/Contents/MacOS/AC-1")

# params that take i32/bool (w1); everything else continuous -> f64 (d0)
INT_PARAMS = {
    "compression_mode", "control_mode", "control_mode_channel", "detector_mode",
    "detector_mode_channel", "linking_enabled", "link_n", "link_curve_mode",
    "led_meter_mode", "oversampling_enabled", "oversampler_factor", "maximizer_enabled",
    "peak_detector_enabled", "envelope_ramp_mode", "dual_release_shape",
    "dual_release_shape_channel", "limiter_detector_key", "debug_link",
}
INT_GETTERS = {"link_n", "led_meter_mode", "compression_mode", "control_mode",
               "latency_samples", "get_latency_samples", "oversampling_enabled"}


class AC1:
    def __init__(self, path=BIN, sample_rate=48000.0):
        if not os.path.exists(path):
            sys.exit(f"AC-1 binary not found: {path}")
        self.sr = float(sample_rate)
        self.lib = C.CDLL(path)                      # dlopen the MH_BUNDLE
        self.lib.dynamics_create.restype = C.c_void_p
        self.lib.dynamics_create.argtypes = [C.c_double]   # d0 = sample_rate (feeds EbuR128)
        self.h = self.lib.dynamics_create(self.sr)
        if not self.h:
            sys.exit("dynamics_create returned NULL")
        for fn in ("dynamics_destroy", "dynamics_reset"):
            getattr(self.lib, fn).argtypes = [C.c_void_p]

    def reset(self):
        self.lib.dynamics_reset(self.h)

    def commit(self):
        """REQUIRED after set()s: commits params AND un-mutes. Engine outputs silence until called."""
        fn = self.lib.dynamics_update_parameters
        fn.argtypes = [C.c_void_p]; fn.restype = None
        fn(self.h)

    def set(self, name, value):
        fn = getattr(self.lib, f"dynamics_set_{name}")
        if name in INT_PARAMS:
            fn.argtypes = [C.c_void_p, C.c_int]; fn.restype = None
            fn(self.h, int(value))
        else:
            fn.argtypes = [C.c_void_p, C.c_double]; fn.restype = None
            fn(self.h, float(value))

    def get(self, name):
        fn = getattr(self.lib, f"dynamics_get_{name}")
        fn.argtypes = [C.c_void_p]
        fn.restype = C.c_int if name in INT_GETTERS else C.c_double
        return fn(self.h)

    def process(self, x):
        """Mono f64, separate in/out: fn(handle, in_ptr, out_ptr, len). Returns new array."""
        x = np.ascontiguousarray(x, dtype=np.float64)
        out = np.zeros_like(x)
        fn = self.lib.dynamics_process_audio_mono_f64
        fn.argtypes = [C.c_void_p, C.POINTER(C.c_double), C.POINTER(C.c_double), C.c_size_t]
        fn.restype = None
        fn(self.h, x.ctypes.data_as(C.POINTER(C.c_double)),
           out.ctypes.data_as(C.POINTER(C.c_double)), x.size)
        return out

    def __del__(self):
        try:
            if getattr(self, "h", None):
                self.lib.dynamics_destroy(self.h)
        except Exception:
            pass


def selftest():
    d = AC1()
    print(f"loaded {BIN}\n  handle={hex(d.h)}  latency={d.get('latency_samples')}")
    d.set("threshold_db", -30.0)
    d.set("ratio", 4.0)
    d.set("knee_db", 6.0)
    d.set("detector_attack_time", 0.005)     # SECONDS (5 ms). ms saturates the clamp.
    d.set("detector_release_time", 0.1)      # SECONDS (100 ms)
    d.commit()                       # commit + un-mute (else output is silent)
    print(f"  readback: threshold={d.get('threshold_db'):.2f} ratio={d.get('ratio'):.2f} "
          f"knee={d.get('knee_db'):.2f}")

    SR = 48000
    blk = 4096
    x = 10 ** (-6 / 20) * np.sin(2 * np.pi * 1000 * np.arange(blk) / SR)   # -6 dBFS sine
    d.process(x)                     # block 0 = latency/warmup, discard
    y = d.process(x)                 # block 1 = settled
    rms_in = 20 * np.log10(np.sqrt(np.mean(x ** 2)) + 1e-12)
    rms_out = 20 * np.log10(np.sqrt(np.mean(y ** 2)) + 1e-12)
    gr_lin = d.get("block_gain_reduction_left")        # NOTE: linear gain, not dB
    print(f"  process: in={rms_in:.2f} dBrms  out={rms_out:.2f} dBrms  Δ={rms_out-rms_in:.2f} dB")
    print(f"  internal: GR_L={gr_lin:.3f} lin ({20*np.log10(gr_lin+1e-12):+.2f} dB)  "
          f"lambda={d.get('last_block_lambda'):.4f}")
    print("OK" if rms_out < rms_in - 0.5 else "WARN: no gain reduction — check param IDs")


if __name__ == "__main__":
    selftest()
