{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easby-producer/ArrangementDecision.schema.json",
  "title": "ArrangementDecision",
  "description": "Emitted by Easby-producer for song-form / section-arrangement / transition-design requests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "section", "energy_level", "elements_add", "elements_remove", "transition_in", "bar_count", "notes"],
  "properties": {
    "type": {"const": "ArrangementDecision"},
    "section": {
      "enum": ["intro", "verse", "pre_chorus", "chorus", "bridge", "breakdown", "build", "drop", "hook", "head", "solo", "outro", "tag"]
    },
    "energy_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1 = sparsest intro/outro; 5 = max-density chorus/drop/final-chorus + ornament. See 11-owsinski §3 for genre-aware quantitative scale."
    },
    "elements_add": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "elements_remove": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "transition_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bars"],
      "properties": {
        "type": {"enum": ["riser", "reverse_cymbal", "reverse_impact", "noise_sweep", "snare_roll", "drop_out", "fx_hit", "filter_sweep", "none"]},
        "bars": {"enum": [0, 1, 2, 4, 8]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "none"}}},
          "then": {"properties": {"bars": {"const": 0}}}
        },
        {
          "if": {"not": {"properties": {"type": {"const": "none"}}}},
          "then": {"properties": {"bars": {"enum": [1, 2, 4, 8]}}}
        }
      ]
    },
    "bar_count": {"type": "integer", "minimum": 1},
    "notes": {"type": "string", "minLength": 1}
  }
}
