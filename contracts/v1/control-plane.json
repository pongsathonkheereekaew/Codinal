{
  "fixture_version": 1,
  "contract": "codinal.control-plane.v1",
  "redaction": {
    "forbidden_value_markers": ["sk-", "AIza", "ghp_"]
  },
  "all_v1_http_routes": {
    "unauthenticated_status": 401,
    "www_authenticate": "Bearer"
  },
  "route_surface": {
    "count": 108,
    "sha256": "69d126248ff0da3f0b3feecf4ace3bb520c38c62bd29315215b945d47be7aba0"
  },
  "http": [
    {
      "id": "health-without-bearer-is-rejected",
      "request": {"method": "GET", "path": "/v1/health", "headers": {}},
      "response": {
        "status": 401,
        "headers": {"www-authenticate": "Bearer"},
        "json": {"detail": "unauthorized"}
      }
    },
    {
      "id": "health-with-bearer-is-accepted",
      "request": {
        "method": "GET",
        "path": "/v1/health",
        "headers": {"authorization": "Bearer <session-token>"}
      },
      "response": {
        "status": 200,
        "json": {
          "status": "ok",
          "capabilities": {
            "runtime_owner": "python",
            "turn_execution_owner": "python",
            "receipt_write_owner": "python",
            "start_turn": true,
            "interrupt_turn": true
          }
        }
      }
    }
  ],
  "websocket": [
    {
      "id": "missing-protocol-is-rejected",
      "path": "/ws/events",
      "protocols": [],
      "close_code": 4401
    },
    {
      "id": "wrong-origin-is-rejected-before-auth",
      "path": "/ws/events",
      "origin": "https://untrusted.invalid",
      "protocols": ["codinal.v1", "codinal.auth.<session-token>"],
      "close_code": 4403
    },
    {
      "id": "valid-protocol-uses-no-url-token",
      "path": "/ws/events",
      "protocols": ["codinal.v1", "codinal.auth.<session-token>"],
      "forbidden_url_parts": ["?", "<session-token>"],
      "accepted_subprotocol": "codinal.v1",
      "ping_response": {"type": "pong"}
    }
  ],
  "events": [
    {
      "id": "reconnect-preserves-published-order",
      "stream": "session",
      "sequence": ["turn_started", "tool_proposed", "turn_completed"]
    },
    {
      "id": "reconnect-receives-only-future-events",
      "stream": "session",
      "before_reconnect": ["turn_started"],
      "after_reconnect": ["turn_completed"]
    }
  ]
}
