{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easby-producer/SoundDesignTarget.schema.json",
  "title": "SoundDesignTarget",
  "description": "Emitted by Easby-producer for synthesis/patch questions. Describes waveform + VCF + ADSR + optional FM params.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "waveform", "vcf", "adsr_vca", "adsr_vcf", "notes"],
  "properties": {
    "type": {"const": "SoundDesignTarget"},
    "waveform": {
      "enum": ["sawtooth", "square", "sine", "triangle", "noise", "pulse", "fm", "additive"]
    },
    "vcf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cutoff_relative", "resonance", "slope_db_oct"],
      "properties": {
        "type": {"enum": ["lpf", "hpf", "bpf"]},
        "cutoff_relative": {"enum": ["closed", "half", "open"]},
        "resonance": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "slope_db_oct": {"enum": [6, 12, 24]}
      }
    },
    "adsr_vca": {"$ref": "#/$defs/adsr"},
    "adsr_vcf": {"$ref": "#/$defs/adsr"},
    "fm_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C_ratio", "M_ratio", "I_start", "I_end"],
      "properties": {
        "C_ratio": {"type": "number", "minimum": 0},
        "M_ratio": {"type": "number", "minimum": 0},
        "I_start": {"type": "number", "minimum": 0},
        "I_end": {"type": "number", "minimum": 0}
      }
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"waveform": {"const": "fm"}}},
      "then": {"required": ["fm_params"]}
    }
  ],
  "$defs": {
    "adsr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "decay", "sustain", "release"],
      "properties": {
        "attack": {"enum": ["fast", "med", "slow"]},
        "decay": {"enum": ["short", "med", "long"]},
        "sustain": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "release": {"enum": ["short", "med", "long"]}
      }
    }
  }
}
