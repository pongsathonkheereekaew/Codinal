{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easby-producer/VariationDecision.schema.json",
  "title": "VariationDecision",
  "description": "Emitted by Easby-producer for any loop/melody/chord variation request. Codebase (CreateVariationController + real_helper.py) consumes this and executes the slice_ops.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "amt", "operation", "slice_ops", "expected_audible_change", "confidence", "theory_basis"],
  "properties": {
    "type": {"const": "VariationDecision"},
    "amt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Variation amount 1=subtle through 5=section-level change. Easby gates via pitch confidence."
    },
    "operation": {
      "enum": [
        "sequence",
        "inversion",
        "deceptive_cadence",
        "secondary_dominant",
        "mode_mixture",
        "picardy",
        "borrowed_bVII",
        "borrowed_bVI",
        "sequential_lift",
        "passing_tone"
      ]
    },
    "slice_ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_idx", "semitone_delta", "time_stretch"],
        "properties": {
          "slice_idx": {"type": "integer", "minimum": 0},
          "semitone_delta": {"type": "integer", "minimum": -12, "maximum": 12},
          "time_stretch": {"type": "number", "minimum": 0.5, "maximum": 2.0}
        }
      }
    },
    "expected_audible_change": {
      "type": "string",
      "minLength": 1,
      "description": "MUST state an improvement direction (energy lift / contrast / hook lift / tension-release). Pure cosmetic deltas fail the Make-It-Better-Not-Different gate (Owsinski O-Ch10)."
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "theory_basis": {
      "type": "string",
      "minLength": 1,
      "description": "Cite the 06* sub-file + section. E.g. '06b-secondary-borrowed.md §6 — V/V in C major'."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"enum": ["passing_tone", "inversion"]}}},
      "then": {"properties": {"confidence": {"minimum": 0.7}}}
    },
    {
      "if": {"properties": {"operation": {"const": "passing_tone"}}},
      "then": {
        "properties": {
          "slice_ops": {
            "items": {"properties": {"semitone_delta": {"minimum": -4, "maximum": 4}}}
          }
        }
      }
    }
  ]
}
