#!/usr/bin/env bash
# AC-1 static extraction driver. Thins arch, demangles symbols, pulls the Rust FFI
# surface + embedded WebKit UI, then hands off to radare2 (cmds.r2).
# Read-only on the plugin. Clean-room: we MEASURE/MAP, we don't copy asm into product.
#
# Architecture (confirmed): JUCE 8.0.12 C++ wrapper/UI  ->  Rust `dynamics` crate via C FFI.
# All DSP lives behind 108 `_dynamics_*` exports. That boundary IS the spec.
set -euo pipefail

BUNDLE="/Library/Audio/Plug-Ins/VST3/AC-1.vst3"
BIN="$BUNDLE/Contents/MacOS/AC-1"
OUT="$(cd "$(dirname "$0")" && pwd)"     # AC-1/decomp
ARCH="${1:-arm64}"                       # arm64 | x86_64
THIN="$OUT/ac1_$ARCH"

[ -f "$BIN" ] || { echo "AC-1 binary not found at $BIN"; exit 1; }

echo "==> thin $ARCH"
lipo "$BIN" -thin "$ARCH" -output "$THIN"
file "$THIN"

echo "==> demangled symbol map -> syms.txt  (C++ + Rust legacy mangling)"
# c++filt also de-obfuscates Rust legacy names ($LT$ -> <, .. -> ::)
nm -n "$THIN" | c++filt > "$OUT/syms.txt"
wc -l < "$OUT/syms.txt" | xargs echo "    symbols:"

echo "==> FFI surface -> ffi.txt  (the DSP contract)"
nm -U "$THIN" | grep -E ' T _dynamics_' | awk '{print $1"  "$3}' | sort > "$OUT/ffi.txt"
grep -c . "$OUT/ffi.txt" | xargs echo "    dynamics_* exports:"

echo "==> Rust type/module map -> rust-types.txt"
nm "$THIN" | c++filt | grep -oE 'dynamics(\.\.[a-zA-Z_]+)+' | sort -u > "$OUT/rust-types.txt" || true

echo "==> embedded UI / param strings -> ui-strings.txt"
strings -n 5 "$THIN" | grep -iE '\.(html|js|css|svg)|paramID|NormalisableRange|skew|window\.__JUCE__' \
    | sort -u > "$OUT/ui-strings.txt" || true

echo
echo "next: r2 -i \"$OUT/cmds.r2\" \"$THIN\""
echo "      (or:  r2 -A \"$THIN\"  then  . $OUT/cmds.r2 )"
