{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easby-mastering/StemMasterDecision.schema.json",
  "title": "StemMasterDecision",
  "description": "Mastering for stem-delivered material (drums / bass / instruments / vocals stems instead of a single stereo mix).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "stems", "processing_order", "latency_aligned", "target_lufs", "true_peak_ceiling", "notes"],
  "properties": {
    "type": {"const": "StemMasterDecision"},
    "stems": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "file", "peak_dbfs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "peak_dbfs": {"type": "number", "minimum": -60, "maximum": 0}
        }
      }
    },
    "processing_order": {"enum": ["individual_then_sum", "sum_then_process"]},
    "latency_aligned": {
      "const": true,
      "description": "MANDATORY — sample-accurate alignment across stems. Refuse if false."
    },
    "target_lufs": {"type": "number", "minimum": -30, "maximum": 0},
    "true_peak_ceiling": {"type": "number", "minimum": -3.0, "maximum": 0},
    "notes": {"type": "string", "minLength": 1}
  }
}
