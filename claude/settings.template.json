{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "__ZAI_TOKEN__",
    "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.5-air",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.2[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.2[1m]",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Agent"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/lowfat-rtk-router.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/ctx-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/sessionstart-resume.sh"
          },
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/claude-mem-backup.sh"
          },
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/lance-autoindex.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claudeclaw@claudeclaw": false,
    "claude-mem@thedotmack": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "clangd-lsp@claude-plugins-official": true,
    "ecc@ecc": false,
    "claude-code-harness@claude-code-harness-marketplace": false,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claudeclaw": {
      "source": {
        "source": "github",
        "repo": "moazbuilds/claudeclaw"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/everything-claude-code.git"
      }
    },
    "claude-code-harness-marketplace": {
      "source": {
        "source": "github",
        "repo": "Chachamaru/claude-code-harness"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}