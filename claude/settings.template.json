{
  "env": {
    "ECC_DISABLED_HOOKS": "stop:cost-tracker,post:ecc-context-monitor,pre:edit-write:gateguard-fact-force,pre:bash:gateguard-fact-force",
    "ECC_HOOK_PROFILE": "minimal",
    "ECC_SESSION_START_MAX_CHARS": "0",
    "ECC_DISABLED_MCPS": "exa,github,memory,playwright,sequential-thinking",
    "CLAUDE_EFFORT": "max"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Agent"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/lowfat-rtk-router.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/ctx-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/sessionstart-resume.sh"
          },
          {
            "type": "command",
            "command": "__HOME__/.claude/scripts/claude-mem-backup.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claudeclaw@claudeclaw": false,
    "claude-mem@thedotmack": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "clangd-lsp@claude-plugins-official": true,
    "ecc@ecc": true,
    "claude-code-harness@claude-code-harness-marketplace": false,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claudeclaw": {
      "source": {
        "source": "github",
        "repo": "moazbuilds/claudeclaw"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/everything-claude-code.git"
      }
    },
    "claude-code-harness-marketplace": {
      "source": {
        "source": "github",
        "repo": "Chachamaru127/claude-code-harness"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}
