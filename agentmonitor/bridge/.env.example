# TownHall bridge — คัดลอกเป็น .env แล้วเติมค่า (chmod 600 .env)
PORT=4777
BIND=127.0.0.1
# ใช้ PWA ผ่าน Tailscale: เปลี่ยน BIND เป็น IP tailscale + ตั้ง API_TOKEN
API_TOKEN=
DB_PATH=./townhall.db

# Cursor Background Agents API (poller = ground truth + followup ตอน approve)
# คีย์จาก cursor.com → Settings → API keys
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com

# Telegram แจ้งเตือน (โหมด C) — ใช้ bot token เดิมของ Hermes ได้:
# bridge เรียก sendMessage อย่างเดียว ไม่ polling จึงไม่ชนกับ gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7024035068
# override ได้ถ้า topic id ต่างจาก harness-flow default:
# TELEGRAM_TOPICS={"General":215,"Coding":234,"Easby":219,"Auric":236}
NOTIFY_TOPIC=Coding

# สั่งงานจากเกม → Hermes (เลือกโหมด — ดู README ส่วน Intake)
INTAKE_MODE=auto
# โหมด A — hermes CLI/local API (รัน scripts/spike-hermes-cli.sh เพื่อหา syntax จริงก่อน)
# ใช้ $AM_TEXT / $AM_TOPIC / $AM_CHAT ใน template เพื่อเลี่ยงปัญหา quoting:
# HERMES_SEND_CMD=hermes send --chat {chat} --topic {topic} --text "$AM_TEXT"
HERMES_SEND_CMD=
# โหมด B — ส่งในนามบัญชี Telegram ของคุณ (MTProto):
# cd bridge && npm i telegram && node ../scripts/tg-login.mjs
TG_API_ID=
TG_API_HASH=
TG_USER_SESSION=
TG_BOT_USERNAME=

# เส้นทาง harness-flow (ปุ่ม restart gateway ใช้ hermes/restart-gateway.sh)
HARNESS_FLOW_DIR=~/harness-flow
ROUTER_URL=http://127.0.0.1:20128/dashboard

# กติกาที่ล็อกไว้จาก grill session — แก้ได้แต่ควรรู้ว่าแก้ทำไม
STALL_MINUTES=10
PAUSE_MINUTES=45
MAX_AGENTS_PER_MISSION=3
POLL_SECONDS=30
HEALTH_SECONDS=60
